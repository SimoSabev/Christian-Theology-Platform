# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Git worktrees
.worktrees/
.claude/worktrees/

# Superpowers brainstorm artifacts
.superpowers/
.claude/scheduled_tasks.lock

# Koine Greek NT interlinear data (STEPBible TAGNT, CC BY 4.0).
# Not redistributed via this repo per the data maintainers' request —
# run `node scripts/fetch-greek-nt.mjs` to (re)generate locally.
/src/data/bible/greek/*.json

# Septuagint (LXX) plain text (Swete's edition via nathans/lxx-swete, CC BY-SA 4.0).
# Not redistributed via this repo per the ShareAlike license —
# run `node scripts/fetch-lxx-swete.mjs` to (re)generate locally.
/src/data/bible/lxx/*.json

# generated reports / codemap diffs
/.reports/

# scratch / temp working directory
/tmp/

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# logs
*.log
npm-debug.log*
lint_output.txt
